# MongoDB Atlas connection string. Keep the real value in an ignored .env file
# or in your deployment platform's environment settings.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/timetable-scheduler?retryWrites=true&w=majority
# Optional: use public resolvers if Node cannot resolve Atlas SRV records.
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

NODE_ENV=development
PORT=8000
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
