# ── Database ──
MONGO_URI=mongodb://127.0.0.1:27017/timetable-scheduler
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# ── Server Configuration ──
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# ── JWT Authentication ──
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# ── Email System & Safety Controls ──
# Set MAIL_SEND_ENABLED=false to bypass all outgoing SMTP calls in local development/testing
MAIL_SEND_ENABLED=false
# EMAIL_MODE: 'development' | 'sandbox' | 'production'
EMAIL_MODE=development
# TEST_EMAIL: When EMAIL_REDIRECT_TO_TEST=true, all emails in development are redirected here
TEST_EMAIL=developer@example.com
EMAIL_REDIRECT_TO_TEST=false

# ── SMTP Server (Nodemailer) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="EduX Planner" <no-reply@edux.edu>

# ── Razorpay Payment Gateway (Test Mode) ──
RAZORPAY_KEY_ID=rzp_test_mockKeyId
RAZORPAY_KEY_SECRET=mockSecret
RAZORPAY_WEBHOOK_SECRET=mockWebhookSecret

# ── Cloudinary Media Storage ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ── AI Services (Gemini / DeepSeek) ──
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# ── Demo Login Credentials ──
ENABLE_DEMO_LOGIN=true
DEMO_ADMIN_EMAIL=admin@edux.com
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_STUDENT_EMAIL=student@edux.com
DEMO_STUDENT_PASSWORD=Student@123
